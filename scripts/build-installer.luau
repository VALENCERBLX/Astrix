--- Generates `dist/install.luau`: one script that, pasted into the Studio
--- command bar, recreates the whole Astrix tree under ReplicatedStorage.
---
--- Run with `lune run scripts/build-installer`.
---
--- This is the **optional** no-Rojo install path. Astrix uses real instance
--- requires, so a normal Rojo sync needs none of this; it exists so the library
--- can be dropped into a place that has no toolchain at all.

local fs = require("@lune/fs")
local luau = require("@lune/luau")

type Entry = { path: string, class: string, source: string? }

local ROOT = "Astrix"

local entries: { Entry } = {}

local function findInit(dir: string): string?
	for _, name in { "init.lua", "init.luau" } do
		if fs.isFile(`{dir}/{name}`) then
			return `{dir}/{name}`
		end
	end

	return nil
end

local function walk(dir: string, path: string)
	local names = fs.readDir(dir)

	table.sort(names)

	for _, name in names do
		local full = `{dir}/{name}`

		if fs.isDir(full) then
			local childPath = `{path}/{name}`
			local init = findInit(full)

			entries[#entries + 1] = {
				path = childPath,
				class = if init then "ModuleScript" else "Folder",
				source = if init then fs.readFile(init :: string) else nil,
			}

			walk(full, childPath)
		elseif string.match(name, "%.luau?$") and not string.match(name, "^init%.luau?$") then
			entries[#entries + 1] = {
				path = `{path}/{string.gsub(name, "%.luau?$", "")}`,
				class = "ModuleScript",
				source = fs.readFile(full),
			}
		end
	end
end

local rootInit = findInit("src")

entries[#entries + 1] = {
	path = ROOT,
	class = if rootInit then "ModuleScript" else "Folder",
	source = if rootInit then fs.readFile(rootInit :: string) else nil,
}

walk("src", ROOT)

local lines: { string } = {
	"--!nocheck",
	"",
	"--[[",
	"\tAstrix installer (generated by scripts/build-installer — do not edit)",
	"",
	"\tPaste this whole file into the Roblox Studio command bar.",
	"",
	"\tAstrix depends on Lume. Install Lume first, or the console will error on",
	"\tstart with a message telling you where it looked.",
	"",
	"\tOptions (set before running, all optional):",
	"",
	"\t  _G.AstrixInstall = {",
	'\t      parent    = game:GetService("ReplicatedStorage"),',
	'\t      name      = "Astrix",',
	"\t      overwrite = true,",
	"\t      select    = true,",
	"\t      silent    = false,",
	"\t  }",
	"]]",
	"",
	"local MODULES = {",
}

for _, entry in entries do
	local source = if entry.source then string.format("%q", entry.source) else "nil"

	lines[#lines + 1] = string.format("{%q,%q,%s},", entry.path, entry.class, source)
end

lines[#lines + 1] = [==[
}

local options = (type(_G.AstrixInstall) == "table" and _G.AstrixInstall or {}) :: any

local parent = options.parent or game:GetService("ReplicatedStorage")
local name = options.name or "Astrix"
local silent = options.silent == true

local function say(message: string)
	if not silent then
		print(message)
	end
end

local existing = parent:FindFirstChild(name)

if existing then
	if options.overwrite == false then
		warn(`Astrix: {name} already exists and overwrite is off; nothing was installed`)
		return
	end

	existing:Destroy()

	say(`Astrix: replaced the existing {parent:GetFullName()}.{name}`)
end

local byPath = {}

for _, entry in MODULES do
	local path, className, source = entry[1], entry[2], entry[3]

	local instance = Instance.new(className)
	local parentPath = string.match(path, "^(.+)/[^/]+$")

	instance.Name = if parentPath then string.match(path, "([^/]+)$") else name

	if source then
		local ok, err = pcall(function()
			instance.Source = source
		end)

		if not ok then
			warn(`Astrix: could not write {path} ({err}). Run this from the Studio command bar or a plugin.`)
			return
		end
	end

	instance.Parent = if parentPath then byPath[parentPath] else parent
	byPath[path] = instance
end

local installed = parent:FindFirstChild(name)

if installed then
	installed:SetAttribute("AstrixVersion", "0.1.0")
	installed:SetAttribute("AstrixInstalledAt", os.time())

	if options.select ~= false then
		pcall(function()
			game:GetService("Selection"):Set({ installed })
		end)
	end
end

if not parent:FindFirstChild("Lume") and not game:GetService("ReplicatedStorage"):FindFirstChild("Lume") then
	warn("Astrix: Lume was not found. Install Lume as well, or the console cannot render.")
end

say(`Astrix installed to {parent:GetFullName()}.{name} ({#MODULES} instances)`)
]==]

local bundle = table.concat(lines, "\n")

local ok, err = pcall(luau.load, bundle, { debugName = "install.luau" })

assert(ok, `generated installer does not compile: {err}`)

if not fs.isDir("dist") then
	fs.writeDir("dist")
end

fs.writeFile("dist/install.luau", bundle)

print(`bundled dist/install.luau ({math.round(#bundle / 1024)}K, {#entries} instances)`)
