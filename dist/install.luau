				props = {\
					BackgroundTransparency = 1,\
					BorderSizePixel = 0,\
					Size = UDim2.new(1, 0, 0, titleHeight),\
					Name = \"Titlebar\",\
					Visible = false,\
					ZIndex = 3,\
