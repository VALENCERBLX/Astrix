\
function Type.defineType(config: DefineTypeConfig): () -> TypeDef\
	return function(): TypeDef\
		local def = config.Mask()\
		if config.Validate then\
			def:where(config.Validate)\
		end\
		return def\
	end\
end\
\
return Type\
