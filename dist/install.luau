						ref = \"titleIcon\",\
						props = {\
							BackgroundTransparency = 1,\
							ImageTransparency = theme.transparency.muted,\
							ImageColor3 = theme.color.textMuted,\
							ScaleType = Enum.ScaleType.Fit,\
\
							Size = UDim2.fromOffset(theme.size.icon, theme.size.icon),\
							LayoutOrder = 1,\
							Visible = false,\
							Name = \"Icon\",\
							Image = \"\",\
						},\
					},\
					{\
						class = \"TextLabel\",\
						ref = \"titleText\",\
