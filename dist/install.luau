	local results = {}\
	for _, action in _actions do\
		if action.Config.Tags and table.find(action.Config.Tags, tag) then\
			table.insert(results, action)\
		end\
	end\
	return results\
end\
\
function Registry.All(): { Types.ActionHandle }\
	local results = {}\
	for _, action in _actions do\
		table.insert(results, action)\
	end\
	return results\
end\
\
return Registry"},
