Button.__index = Button\
\
export type Variant = \"solid\" | \"soft\" | \"ghost\" | \"outline\" | \"danger\"\
\
export type Fields = Types.NodeFields & Types.ElementFields & {\
	value: string,\
	variant: Variant,\
	iconImage: string,\
	fixedWidth: number?,\
	loading: boolean,\
\
	baseTransparency: number,\
	hovering: boolean,\
