{"Astrix/_Types/Player","ModuleScript","--!strict\
\
--- Resolves a player by name or display name, case-insensitively, preferring an\
--- exact match over a prefix one.\
---\
--- Kyn's own `@Players.Rin` is the *reference* form and resolves in the session.\
--- This provider is the **casting** form: it turns a bare word that landed in a\
--- `Player`-typed argument slot into a real Player.\
--- @section Arguments\
\
local Players = game:GetService(\"Players\")\
\
local Types = require(script.Parent.Parent.Types)\
\
local function find(raw: string): Player?\
	local query = string.lower(tostring(raw))\
\
	if query == \"\" then\
		return nil\
	end\
\
	local prefix: Player? = nil\
\
	for _, player in Players:GetPlayers() do\
		local name = string.lower(player.Name)\
		local display = string.lower(player.DisplayName)\
\
		if name == query or display == query then\
			return player\
		end\
\
		if not prefix and (string.sub(name, 1, #query) == query or string.sub(display, 1, #query) == query) then\
			prefix = player\
		end\
	end\
\
	return prefix\
end\
\
local Player: Types.ArgumentTypeProvider<Player> = {\
	Name = \"Player\",\
\
	Validate = function(raw: string): boolean\
		return find(raw) ~= nil\
	end,\
\
	Resolve = function(raw: string): Player?\
		return find(raw)\
	end,\
\
	Suggest = function(prefix: string): { string }\
		local query = string.lower(tostring(prefix))\
		local out = {}\
\
		for _, player in Players:GetPlayers() do\
			if string.sub(string.lower(player.Name), 1, #query) == query then\
				table.insert(out, player.Name)\
			end\
		end\
\
		table.sort(out)\
\
		return out\
	end,\
}\
\
return Player\
"},
{"Astrix/_Types/String","ModuleScript","--!strict\
\
--- Anything is a string. Present for symmetry, so `CommandContext` can look up\
--- a provider for every declared type without special-casing.\
--- @section Arguments\
\
local Types = require(script.Parent.Parent.Types)\
\
local String: Types.ArgumentTypeProvider<string> = {\
	Name = \"String\",\
\
	Validate = function(raw: string): boolean\
		return type(raw) == \"string\"\
	end,\
\
	Resolve = function(raw: string): string?\
		return tostring(raw)\
	end,\
\
	Suggest = function(): { string }\
		return {}\
	end,\
}\
\
return String\
"},
{"Astrix/_Types/Vector3","ModuleScript","--!strict\
\
--- Accepts `1,2,3` or `1 2 3`. The `@Vector3(1, 2, 3)` constructor form is\
--- handled by the Kyn session and arrives here already typed.\
--- @section Arguments\
\
local Types = require(script.Parent.Parent.Types)\
\
local function parse(raw: string): Vector3?\
	local parts = {}\
\
	for piece in string.gmatch(tostring(raw), \"[^,%s]+\") do\
		local number = tonumber(piece)\
\
		if not number then\
			return nil\
		end\
\
		table.insert(parts, number)\
	end\
\
	if #parts ~= 3 then\
		return nil\
	end\
\
	return Vector3.new(parts[1], parts[2], parts[3])\
end\
\
local Provider: Types.ArgumentTypeProvider<Vector3> = {\
	Name = \"Vector3\",\
\
	Validate = function(raw: string): boolean\
		return parse(raw) ~= nil\
	end,\
\
	Resolve = function(raw: string): Vector3?\
		return parse(raw)\
	end,\
\
	Suggest = function(): { string }\
		return { \"0,0,0\" }\
	end,\
}\
\
return Provider\
"},
{"Astrix/_Utility","Folder",nil},
}

local options = (type(_G.AstrixInstall) == "table" and _G.AstrixInstall or {}) :: any

local parent = options.parent or game:GetService("ReplicatedStorage")
local name = options.name or "Astrix"
local silent = options.silent == true

local function say(message: string)
	if not silent then
		print(message)
	end
end

local existing = parent:FindFirstChild(name)

if existing then
	if options.overwrite == false then
		warn(`Astrix: {name} already exists and overwrite is off; nothing was installed`)
		return
	end

	existing:Destroy()

	say(`Astrix: replaced the existing {parent:GetFullName()}.{name}`)
end

local byPath = {}

for _, entry in MODULES do
	local path, className, source = entry[1], entry[2], entry[3]

	local instance = Instance.new(className)
	local parentPath = string.match(path, "^(.+)/[^/]+$")

	instance.Name = if parentPath then string.match(path, "([^/]+)$") else name

	if source then
		local ok, err = pcall(function()
			instance.Source = source
		end)

		if not ok then
			warn(`Astrix: could not write {path} ({err}). Run this from the Studio command bar or a plugin.`)
			return
		end
	end

	instance.Parent = if parentPath then byPath[parentPath] else parent
	byPath[path] = instance
end

local installed = parent:FindFirstChild(name)

if installed then
	installed:SetAttribute("AstrixVersion", "0.1.0")
	installed:SetAttribute("AstrixInstalledAt", os.time())

	if options.select ~= false then
		pcall(function()
			game:GetService("Selection"):Set({ installed })
		end)
	end
end

if not parent:FindFirstChild("Lume") and not game:GetService("ReplicatedStorage"):FindFirstChild("Lume") then
	warn("Astrix: Lume was not found. Install Lume as well, or the console cannot render.")
end

say(`Astrix installed to {parent:GetFullName()}.{name} ({#MODULES} instances)`)
