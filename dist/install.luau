	local action = _actions[name]\
	if action then\
		action:Destroy()\
		_actions[name] = nil\
	end\
end\
\
function Registry.Clear()\
	for name, action in _actions do\
		action:Destroy()\
		_actions[name] = nil\
	end\
end\
