		},\
	})\
\
	local fields: Fields = {\
		app = app,\
		scope = scope,\
		instance = root :: GuiObject,\
		refs = refs,\
		bindings = {},\
		events = {},\
		owner = nil,\
		dead = false,\
\
		kind = \"button\",\
		desired = Vector2.new(96, theme.size.control),\
		margin = 0,\
		fill = false,\
		grow = false,\
		enabled = true,\
		measured = false,\
\
		value = \"\",\
		variant = \"solid\",\
