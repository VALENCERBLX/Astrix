		NumberSequenceKeypoint.new(0, 1),\
		NumberSequenceKeypoint.new(0.08, 0),\
		NumberSequenceKeypoint.new(0.92, 0),\
		NumberSequenceKeypoint.new(1, 1),\
	})\
