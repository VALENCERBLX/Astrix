	function merged:IsHeld(): boolean\
		for _, action in actions do\
			if action:IsHeld() then return true end\
		end\
		return false\
	end\
\
	function merged:Destroy()\
		for _, action in actions do\
			action:Destroy()\
		end\
	end\
\
