	for _, sibling in parent:GetChildren() do\
		if sibling:IsA(\"GuiObject\") and sibling ~= self.instance then\
			highest = math.max(highest, sibling.ZIndex)\
		end\
	end\
\
	self.instance.ZIndex = highest + 1\
