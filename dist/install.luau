			BackgroundTransparency = 0,\
			BorderSizePixel = 0,\
\
			AutoButtonColor = false,\
			Selectable = true,\
			Size = UDim2.fromOffset(96, theme.size.control),\
\
			Name = \"Button\",\
			Text = \"\",\
