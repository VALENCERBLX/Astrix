{"Astrix/_Packages/Substance/Particle/Type/Constructors","ModuleScript","-- MaterialSubstance\
-- Particle/Type/Constructors.lua\
-- Plinko Labs\
\
local TypeDef = require(script.Parent.TypeDef)\
\
export type TypeDef = TypeDef.TypeDef\
